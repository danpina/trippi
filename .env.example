# If using Supabase: use the session pooler on port 5432, not the direct-connection host
# (IPv6-only) or the transaction pooler on 6543 (breaks `prisma db push`/migrate) — see README.
DATABASE_URL="postgresql://user:password@host:5432/dbname"
SESSION_SECRET="generate-with: node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\""
ADMIN_EMAIL="admin@tripswap.dev"
NEXT_PUBLIC_MAPTILER_KEY="get-a-free-key-at-maptiler.com"
