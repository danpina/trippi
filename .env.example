# If using Supabase: DATABASE_URL is the transaction pooler (port 6543, ?pgbouncer=true) for
# app runtime queries; DIRECT_URL is the session pooler (port 5432) used only for schema
# push/migrations. Don't use the direct-connection host (db.<ref>.supabase.co) — it's IPv6-only.
# See README for why (connection-pool exhaustion under serverless is the failure mode).
DATABASE_URL="postgresql://user:password@host:6543/dbname?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/dbname"
SESSION_SECRET="generate-with: node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\""
ADMIN_EMAIL="admin@tripswap.dev"
NEXT_PUBLIC_MAPTILER_KEY="get-a-free-key-at-maptiler.com"
